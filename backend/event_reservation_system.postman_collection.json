    },
    {
      "name": "3. 10-Minute Reservation Holds",
      "item": [
        {
          "name": "Place 10-Minute Hold on Tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.holdId) {",
                  "    pm.collectionVariables.set('lastHoldId', json.holdId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "usr_att_1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tier_id\": \"tier_ga_1\",\n  \"quantity\": 2,\n  \"hold_minutes\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "hold"]
            }
          }
        },
        {
          "name": "Inspect Active Hold Status & Remaining Seconds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{lastHoldId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{lastHoldId}}"]
            }
          }
        },
        {
          "name": "Cancel & Release Hold Manually",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hold_id\": \"{{lastHoldId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/release",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "release"]
            }
          }
        }
      ]
    },
    {
