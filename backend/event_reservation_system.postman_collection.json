      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "List Seeded Users & Current Persona",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "usr_att_1" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users"]
            }
          }
        },
        {
          "name": "RBAC Edge Case: Attendee Forbidden from Creating Event (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "usr_att_1" },
              { "key": "x-role", "value": "ATTENDEE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Festival\",\n  \"venue\": \"Nowhere\",\n  \"event_date\": \"2026-12-01\",\n  \"sales_cutoff_date\": \"2026-11-30\",\n  \"tiers\": [{ \"name\": \"General\", \"price\": 20, \"capacity\": 10 }]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        }
      ]
    },
    {
