{
  "info": {
    "_postman_id": "c1f79a94-4b53-4b0e-b7d5-d09f7a931088",
    "name": "Multi-Tenant Event & Ticket Reservation System API",
    "description": "Comprehensive Postman test collection for EventNest. Covers Role-Based Access Control (RBAC), 10-minute temporary holds, ACID database transactions, concurrency double-booking prevention, mock payment gateway simulation, background worker sweeps, and organizer analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "activeTierId",
      "value": "tier_vip_1",
      "type": "string"
    },
    {
      "key": "lastHoldId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
