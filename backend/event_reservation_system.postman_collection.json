              "raw": "{\n  \"title\": \"Cloud Native & AI Summit 2026\",\n  \"description\": \"Architecture and concurrency masterclasses.\",\n  \"venue\": \"Moscone Center, San Francisco\",\n  \"event_date\": \"2026-12-15T09:00:00Z\",\n  \"sales_cutoff_date\": \"2026-12-14T23:59:59Z\",\n  \"tiers\": [\n    { \"name\": \"VIP Pass\", \"price\": 199.99, \"capacity\": 20 },\n    { \"name\": \"Standard Entry\", \"price\": 49.99, \"capacity\": 100 }\n  ]\n}"
